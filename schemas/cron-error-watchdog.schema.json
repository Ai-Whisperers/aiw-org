{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent.state \u2014 cron-error-watchdog.json",
  "description": "Cron error watchdog output. Phase 28 R5 (generated from live state).",
  "type": "object",
  "required": [
    "timestamp",
    "jobs_in_error",
    "alert_sent",
    "details"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "jobs_in_error": {
      "type": "integer",
      "minimum": 0
    },
    "alert_sent": {
      "type": "boolean"
    },
    "alert_text": {
      "type": "string"
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "last_error"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "schedule": {
            "type": "string"
          },
          "last_run_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_error": {
            "type": "string"
          },
          "no_agent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
