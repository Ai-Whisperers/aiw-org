{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent.state \u2014 kiki-prep.json",
  "description": "Kiki-coach preparation snapshot. Phase 28 R5: refreshed (live state has different fields).",
  "type": "object",
  "required": [
    "last_run"
  ],
  "properties": {
    "last_run": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "open_stuck": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "kiki_repos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recent_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "recent_files_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
